# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.claude
# /public/uploads — файлы в git для Vercel деплоя

/src/generated/prisma

# Python venv
.venv/

# Backups
/backups/
docs/closing-docs/
docs/ТЗ_*
project-rules/
project-plan/

# Контент, загруженный редакторами через CMS. Живёт только на сервере (55 МБ
# фотографий новостей): в репозитории ему не место, но и затирать его деплоем
# нельзя — поэтому явно исключаем, а не «просто не добавляем».
/public/uploads/

# Слепки старых сборок и бэкапы, которые накапливает деплой на сервере.
/.next.*
/.deploy-backup/
/.deploy-backups/
/backups/
